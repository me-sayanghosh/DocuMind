# ==============================================================================
# DocuMind Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your production server:
#      cp .env.production.example .env
# 2. Generate a secure JWT secret:
#      openssl rand -hex 32
# 3. Generate a secure Postgres password:
#      openssl rand -hex 16
# 4. Fill in your GEMINI_API_KEY and DOMAIN/IP.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Domain & Web Address (e.g., https://documind.yourdomain.com or http://<VPS_IP>)
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-generated-database-password
POSTGRES_DB=docchat
# DATABASE_URL used by backend and migrations:
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-generated-database-password@db:5432/docchat

# Redis Queue
REDIS_URL=redis://redis:6379/0

# LLM Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=gemini-2.5-flash

# Embeddings & Reranking
# 'hash' is lightweight & zero-download (fastest startup).
# Switch to 'sentence_transformers' if you want full local HuggingFace embeddings.
EMBED_PROVIDER=hash
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RERANK_MODEL=BAAI/bge-reranker-base
RELEVANCE_THRESHOLD=0.35

# Authentication & Security (MUST be >= 32 random characters in production)
# Run: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Document Upload & Storage Limits
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=300

# Rate Limits & Abuse Controls
RATE_LIMIT_PER_MINUTE=30
CHAT_RATE_LIMIT_PER_MINUTE=10
DAILY_QUESTION_QUOTA=100

# Email Notifications & Workspace Invites (Optional)
EMAILS_ENABLED=false
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=
# Option 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_FROM_NAME=DocuMind
