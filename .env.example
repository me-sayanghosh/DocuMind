# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/docchat
# For running without external postgres in lightweight mode:
# DATABASE_URL=sqlite+aiosqlite:///./docchat.db

# Redis & Queue
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_FAST_MODEL=claude-3-5-haiku-20241022

# Embeddings & Reranker
EMBED_PROVIDER=hash
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RERANK_MODEL=BAAI/bge-reranker-base
RELEVANCE_THRESHOLD=0.35

# Auth & Security
JWT_SECRET=insecure-dev-jwt-secret-please-change-to-32-bytes-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage & Upload Limits
STORAGE_BACKEND=local
UPLOAD_DIR=/tmp/docchat/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=300

# Rate Limits & Quotas
RATE_LIMIT_PER_MINUTE=30
CHAT_RATE_LIMIT_PER_MINUTE=10
DAILY_QUESTION_QUOTA=100

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
